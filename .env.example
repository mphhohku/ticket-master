# Copy to .env and set credentials on the server only.
# Never paste API keys into the browser; they are not stored by the frontend.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Leave EMBEDDING_API_KEY blank to reuse LLM_API_KEY.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

PORT=3001
# KNOWLEDGE_BASE_DIR=/absolute/path/to/knowledge_base
